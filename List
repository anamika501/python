# Enter two lists of integers
list1 = list(map(int, input("Enter first list: ").split()))
list2 = list(map(int, input("Enter second list: ").split()))

# (a) Check whether lists have the same length
if len(list1) == len(list2):
    print("Both lists have the same length")
else:
    print("Both lists have different lengths")

# (b) Check whether lists have the same sum
if sum(list1) == sum(list2):
    print("Both lists have the same sum")
else:
    print("Both lists have different sums")

# (c) Check whether any value occurs in both lists
common = set(list1) & set(list2)

if common:
    print("Common values:", common)
else:
    print("No common values")
